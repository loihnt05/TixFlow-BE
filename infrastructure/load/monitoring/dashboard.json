          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Sampler age (detect collection gaps)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "load-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-tixflow_sampler_timestamp_seconds"
