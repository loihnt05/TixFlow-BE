      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"tixflow_(oldest_transaction_seconds|oldest_outbox_seconds|consumer_lag_seconds)\"}"
