{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authentication.JwtBearer": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Assistant": {
    "Provider": "OpenAI",
    "Model": "gpt-5.4-mini",
    "BookingApiBaseUrl": "http://localhost:8080",
    "TimeoutSeconds": 30,
    "MaxToolCalls": 8,
    "MaxOutputTokens": 1200,
    "RequestsPerMinute": 10
  },
  "Authentication": {
    "Authority": "http://localhost:8180/realms/tixflow",
    "Audience": "tixflow-api",
    "MockCallbackAudience": "tixflow-mock-callback"
  },
  "Frontend": {
    "Origin": "http://localhost:3000"
  },
  "Booking": {
    "HoldDurationMinutes": 10,
    "LockTimeoutSeconds": 5,
    "IdempotencyRetentionHours": 24
  },
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "localhost:6379"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "",
    "Password": ""
  }
}
