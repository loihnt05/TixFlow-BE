# Copy to .env.production on the VPS; chmod 600. Never source this as a shell script.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
MONITORING_DOMAIN=monitoring.example.com
ACME_EMAIL=operator@example.com
# API/Worker/Frontend must be the tested digest from CI. Public URLs are baked into FE.
API_IMAGE=ghcr.io/your-org/tixflow-api@sha256:REPLACE
WORKER_IMAGE=ghcr.io/your-org/tixflow-worker@sha256:REPLACE
FRONTEND_IMAGE=ghcr.io/your-org/tixflow-frontend@sha256:REPLACE
# deploy.sh resolves all infrastructure images to digests and retains the release manifest.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7.4-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.4
NGINX_IMAGE=nginx:1.28-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.7.3
GRAFANA_IMAGE=grafana/grafana:12.2.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
CERTBOT_IMAGE=certbot/certbot:v4.0.0
# Generate independent 32+ character alphanumeric secrets, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
RABBITMQ_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=operator
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_USERNAME=operator
GRAFANA_ADMIN_PASSWORD=
ASSISTANT_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
